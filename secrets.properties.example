# Copy to secrets.properties (gitignored) to enable the official Jordan prayer timetable.
#
# Create a GitHub *fine-grained* personal access token with:
#   Repository access : only mbanifawaz/Jordan_Prayer_Times_API_Data
#   Permissions       : Contents = Read-only
#
# Do NOT use an account-wide or classic token here: whatever goes in this file is compiled
# into BuildConfig and is therefore extractable from the shipped APK. Scope it so the worst
# case is "someone can read a public-interest prayer timetable".
#
# Leave this file out entirely and the app falls back to the adhan calculation everywhere.
jordanApiToken=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
