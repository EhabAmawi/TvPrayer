<?xml version="1.0" encoding="utf-8"?>
<!-- One day in the "All days" list: the date, then a column per PrayerName. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/calendar_row_background"
    android:baselineAligned="false"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/overlay_text"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/row_hijri"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/overlay_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Time columns, one per PrayerName, added by PrayerCalendarActivity. -->
    <LinearLayout
        android:id="@+id/row_times"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="6"
        android:orientation="horizontal" />
</LinearLayout>
