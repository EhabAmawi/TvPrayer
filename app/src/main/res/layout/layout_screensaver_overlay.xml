<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_panel"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/panel_overlay"
    android:orientation="vertical"
    android:minWidth="360dp">

    <TextView
        android:id="@+id/time_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/overlay_text"
        android:textSize="42sp"
        android:fontFamily="sans-serif-light"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/date_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/overlay_secondary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/hijri_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/accent_teal"
        android:textSize="15sp" />

    <View
        android:layout_width="120dp"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="16dp"
        android:background="@color/accent_teal" />

    <TextView
        android:id="@+id/location_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/overlay_secondary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/next_prayer_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/accent_gold"
        android:textSize="18sp"
        android:textStyle="bold" />
</LinearLayout>