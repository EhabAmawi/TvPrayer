<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_settings"
    android:fillViewport="true"
    android:focusable="false"
    android:descendantFocusability="afterDescendants">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="64dp">
        <Button
            android:id="@+id/back_button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/settings_control_background"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/back"
            android:textColor="@color/overlay_text" />

        <TextView
            android:id="@+id/settings_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_title"
            android:textColor="@color/overlay_text"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/jordan_area_title"
            android:textColor="@color/overlay_text"
            android:textSize="20sp" />
        <Spinner
            android:id="@+id/jordan_area_spinner"
            android:layout_width="420dp"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:background="@drawable/settings_control_background" />
        <TextView
            android:id="@+id/location_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/overlay_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/screensaver_title"
            android:textColor="@color/overlay_text"
            android:textSize="20sp" />
        <Button
            android:id="@+id/set_screensaver_button"
            android:layout_width="420dp"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/settings_control_background"
            android:focusable="true"
            android:text="@string/screensaver_set"
            android:textAllCaps="false"
            android:textColor="@color/overlay_text"
            android:textSize="18sp" />
        <Button
            android:id="@+id/start_screensaver_button"
            android:layout_width="420dp"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/settings_control_background"
            android:focusable="true"
            android:text="@string/screensaver_start_now"
            android:textAllCaps="false"
            android:textColor="@color/overlay_text"
            android:textSize="18sp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/start_after_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/screensaver_start_after"
            android:textColor="@color/overlay_secondary"
            android:textSize="16sp"
            android:visibility="gone" />
        <Spinner
            android:id="@+id/start_after_spinner"
            android:layout_width="420dp"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/settings_control_background"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:visibility="gone" />
        <Button
            android:id="@+id/restore_screensaver_button"
            android:layout_width="420dp"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/settings_control_background"
            android:focusable="true"
            android:text="@string/screensaver_restore"
            android:textAllCaps="false"
            android:textColor="@color/overlay_text"
            android:textSize="18sp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/screensaver_status_text"
            android:layout_width="420dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/overlay_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/language_title"
            android:textColor="@color/overlay_text"
            android:textSize="20sp" />
        <Spinner
            android:id="@+id/language_spinner"
            android:layout_width="420dp"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:background="@drawable/settings_control_background" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/clock_format_title"
            android:textColor="@color/overlay_text"
            android:textSize="20sp" />
        <Spinner
            android:id="@+id/clock_format_spinner"
            android:layout_width="420dp"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:background="@drawable/settings_control_background" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/hijri_offset_title"
            android:textColor="@color/overlay_text"
            android:textSize="20sp" />
        <Spinner
            android:id="@+id/hijri_offset_spinner"
            android:layout_width="420dp"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:background="@drawable/settings_control_background" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/photos_title"
            android:textColor="@color/overlay_text"
            android:textSize="20sp" />
        <Spinner
            android:id="@+id/photo_source_spinner"
            android:layout_width="420dp"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:background="@drawable/settings_control_background" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/slideshow_interval_title"
            android:textColor="@color/overlay_text"
            android:textSize="20sp" />
        <!-- min/max/progress are set from AppPreferences in code; see setupInterval(). -->
        <SeekBar
            android:id="@+id/interval_seekbar"
            android:layout_width="420dp"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true" />
        <TextView
            android:id="@+id/interval_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent_teal"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/about_title"
            android:textColor="@color/overlay_text"
            android:textSize="20sp" />
        <!-- Focusable so the remote can scroll down to it. -->
        <LinearLayout
            android:id="@+id/about_panel"
            android:layout_width="420dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/settings_control_background"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">
            <TextView
                android:id="@+id/about_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_teal"
                android:textSize="16sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/about_credits_title"
                android:textColor="@color/overlay_secondary"
                android:textSize="14sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/about_credits"
                android:textColor="@color/overlay_text"
                android:textSize="16sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/about_source"
                android:textColor="@color/overlay_secondary"
                android:textSize="14sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/about_photos"
                android:textColor="@color/overlay_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
