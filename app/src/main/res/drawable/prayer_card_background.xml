<?xml version="1.0" encoding="utf-8"?>
<!-- state_selected marks the next prayer; set from PrayerTimesActivity. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_container" />
            <stroke android:width="2dp" android:color="@color/accent_gold" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/overlay_surface" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
