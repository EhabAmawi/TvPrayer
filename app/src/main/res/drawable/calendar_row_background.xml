<?xml version="1.0" encoding="utf-8"?>
<!-- Calendar rows: focus as on every other control; state_selected marks today (teal, as on the phone). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_container" />
            <stroke android:width="2dp" android:color="@color/accent_teal" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_container" />
            <stroke android:width="2dp" android:color="@color/accent_teal" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_container" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
