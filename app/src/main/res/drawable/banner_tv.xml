<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV launcher banner (320x180). Referenced from android:banner. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#071019"
                android:endColor="#1B3042" />
        </shape>
    </item>
    <item
        android:width="72dp"
        android:height="72dp"
        android:drawable="@drawable/ic_screensaver"
        android:gravity="center" />
</layer-list>
