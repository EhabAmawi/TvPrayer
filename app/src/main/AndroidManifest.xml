<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The screensaver checks for a connection before choosing online photos. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:banner="@drawable/banner_tv"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CustomTvScreensaver">

        <activity
            android:name=".PrayerTimesActivity"
            android:exported="true"
            android:theme="@style/Theme.JordanPrayerTimes.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PrayerCalendarActivity"
            android:exported="false" />

        <!-- Exported because the system opens it as the dream's settingsActivity. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true" />

        <service
            android:name=".CustomDreamService"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/sample_dream" />
        </service>
    </application>
</manifest>
